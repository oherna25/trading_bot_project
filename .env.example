# Copy to .env and fill in. Never commit .env.
# Without keys the suite and every offline flow still run on canned fixtures.

# Local tier: point one at GGUF weights, keep llama-server (or LLAMA_SERVER_BIN) on PATH.
GLIMMER_GGUF_PATH=
SPARK_OPEN_GGUF_PATH=
LLAMA_SERVER_BIN=llama-server
# LOCAL_SERVER_CTX=4096
# LOCAL_SERVER_THREADS=4

# Market feeds.
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=
# Production host; default is the sandbox host.
# TRADIER_BASE_URL=https://api.tradier.com/v1
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
FINNHUB_API_KEY=
MARKETDATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Chat auth: when set, chat/mcp/cards need Authorization: Bearer <token>.
MUSE_AUTH_TOKEN=

# Alert pushes. With neither set, alerts stay journal-only.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Model phases: without both set, the deterministic paths run.
META_MODEL_API_KEY=
MODEL_DAY_BUDGET_USD=

# Bring your own model: any OpenAI-compatible chat API serves the analyst and
# reviewer roles (briefs, chat router, debate, coach, card reasons, chart reads).
# Your key pays your bill, so no day budget is needed for these calls; grounding,
# voice transcription, and image generation stay on META_MODEL_API_KEY.
USER_MODEL_API_KEY=
# USER_MODEL_BASE_URL=https://api.openai.com/v1
# USER_MODEL_ID=gpt-4o-mini

# Reservation ledger: when set, quota and budget holds persist here across processes.
LEDGER_DIR=data/ledger

# Feed tuning (all optional; defaults shown).
# FEED_TIMEOUT_SECONDS=10
# FEED_CACHE_TTL_SECONDS=60

# Scan breadth (all optional).
# SCAN_UNIVERSE=SPY,QQQ,IWM,DIA,AAPL,MSFT,NVDA,TSLA
# SCAN_BROAD=0
# SCAN_MAX_IDEAS=15
