# Copy to .env and fill in. Never commit .env.
#
# ZERO KEYS (default): nothing below is required. The suite and every offline
# flow run on canned fixtures; the Spark audit reads OFF and the deterministic
# engine answers every page.
#
# ONE KEY (pick one live-model path):
#   BASETEN_API_KEY alone  -> Baseten Muse Spark Open: analyst and reviewer
#                             chat roles, card reasons, deployment candidate
#                             picks. No budget needed.
#   USER_MODEL_API_KEY alone -> your OpenAI-compatible model for the analyst
#                             and reviewer roles. No day budget needed.
#   META_MODEL_API_KEY + MODEL_DAY_BUDGET_USD (both, pair) -> built-in Meta
#                             Spark/Wonder analyst, reviewer, grounding,
#                             voice, and image. The key alone does not unlock
#                             these; the deterministic paths run instead.
#
# ADVANCED / OPTIONAL: everything else below (live feeds, local weights,
# alerts, ledger, tuning). Each is off or defaulted unless set.

# One-key live model paths.
BASETEN_API_KEY=
# BASETEN_REASON_MODEL_ID=meta-models/muse-spark-open-1026
USER_MODEL_API_KEY=
# USER_MODEL_BASE_URL=https://api.openai.com/v1
# USER_MODEL_ID=gpt-4o-mini

# Built-in Meta pair: set both or neither.
META_MODEL_API_KEY=
MODEL_DAY_BUDGET_USD=

# Local tier: point one at GGUF weights, keep llama-server (or LLAMA_SERVER_BIN) on PATH.
GLIMMER_GGUF_PATH=
SPARK_OPEN_GGUF_PATH=
LLAMA_SERVER_BIN=llama-server
# LOCAL_SERVER_CTX=4096
# LOCAL_SERVER_THREADS=4

# Market feeds (all optional; without them, canned fixtures drive the demo).
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=
# Production host; default is the sandbox host.
# TRADIER_BASE_URL=https://api.tradier.com/v1
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
FINNHUB_API_KEY=
MARKETDATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Chat auth: when set, chat/mcp/cards need Authorization: Bearer <token>.
MUSE_AUTH_TOKEN=

# Alert pushes. With neither set, alerts stay journal-only.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reservation ledger: when set, quota and budget holds persist here across processes.
LEDGER_DIR=data/ledger

# Feed tuning (all optional; defaults shown).
# FEED_TIMEOUT_SECONDS=10
# FEED_CACHE_TTL_SECONDS=60

# Scan breadth (all optional).
# SCAN_UNIVERSE=SPY,QQQ,IWM,DIA,AAPL,MSFT,NVDA,TSLA
# SCAN_BROAD=0
# SCAN_MAX_IDEAS=15
