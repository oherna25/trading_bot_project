---
title: Trading bot system overview
---
flowchart TB
    subgraph FEEDS["Data feeds"]
        TRADIER["Tradier sandbox and brokerage"]
        ALPACA["Alpaca live stocks"]
        FINNHUB["Finnhub fallback"]
        EOD["Market Data EOD"]
        YF["yfinance backup"]
        SQZ["SqueezeMetrics CSV reference"]
    end

    subgraph INGEST["Ingestion"]
        ADAPT["Feed adapters"]
        STORE[("ChainSnapshot store")]
    end

    subgraph ENGINE["Exposure engine"]
        GEX["GEX and VEX engine"]
        PROF["GexProfile"]
        REPLAY["Replay harness"]
    end

    subgraph BRAIN["Analyst"]
        LLM["Analyst router"]
        BUDG{"Model key and budget set"}
        SPARK["Muse Spark 1.3"]
        FALL["Deterministic fallback"]
        SIG["Signal"]
        JOUR[("Journal")]
    end

    subgraph MODELS["Meta models"]
        API["Meta Model API"]
        GROUND["Web grounding"]
        VOICE["Voice Transcribe in"]
        IMG["Muse Image cards"]
        WONDER["Muse Wonder review"]
    end

    subgraph RISK["Risk and execution"]
        REV["Risk reviewer veto"]
        INTENT["OrderIntent"]
        RENG["Risk engine"]
        PAPER["Paper venue"]
        LIVE["Live venue default off"]
        KILL["Kill switch"]
    end

    subgraph SURF["Surfaces"]
        CHAT["Telegram chat"]
        CARDS["Trade cards page and chat"]
        CRON["Local scheduler (cron/launchd)"]
    end

    subgraph REAS["Card reasons"]
        META_REASON["Meta reason model"]
        RFALL["Offline reason fallback"]
    end

    TRADIER --> ADAPT
    ALPACA --> ADAPT
    FINNHUB --> ADAPT
    EOD --> ADAPT
    YF --> ADAPT
    SQZ -. cross check .-> GEX
    ADAPT --> STORE
    STORE --> GEX
    GEX --> PROF
    STORE --> REPLAY
    PROF --> LLM
    STORE --> LLM
    LLM --> BUDG
    BUDG -->|yes| SPARK
    BUDG -->|no| FALL
    SPARK --> API
    GROUND -. enrich thesis .-> SPARK
    SPARK --> SIG
    FALL --> SIG
    SPARK -. receipt .-> JOUR
    SIG --> JOUR
    SIG --> REV
    REV --> INTENT
    INTENT --> RENG
    RENG --> PAPER
    RENG --> LIVE
    PAPER --> JOUR
    LIVE --> JOUR
    KILL -. halt .-> RENG
    JOUR -. evidence .-> WONDER
    WONDER --> API
    WONDER -. review note .-> JOUR
    CHAT --> VOICE
    VOICE --> API
    VOICE -. transcript .-> LLM
    LLM -. render card .-> IMG
    IMG --> API
    IMG -. card art .-> CHAT
    CRON --> GEX
    CRON --> CHAT
    CHAT --> LLM
    LLM --> CHAT
    CHAT -. trade cards .-> CARDS
    CARDS --> STORE
    CARDS --> JOUR
    CARDS --> META_REASON
    CARDS --> RFALL
    META_REASON -. reason .-> CARDS
    RFALL -. reason .-> CARDS
